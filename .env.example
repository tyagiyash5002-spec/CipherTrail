# Copy to .env; this file contains no secrets.
HOST=127.0.0.1
PORT=3001
# Set HOST=0.0.0.0 for the three-computer LAN demo.
# Set DATA_DIR to a persistent volume when hosted.
DATA_DIR=./data
STORAGE_LIMIT_MB=700
# Set true behind an HTTPS reverse proxy. False is only for local HTTP demos.
COOKIE_SECURE=false
