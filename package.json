    "test": "node --test tests/*.test.mjs",
    "typecheck:crypto": "tsc -p tsconfig.client-crypto.json",
    "ledger:init": "node ledger/network.mjs init",
    "ledger:start": "node ledger/network.mjs start",
    "ledger:govern": "node ledger/govern.mjs",
    "sample": "node scripts/make-sample.mjs",
    "verify": "node scripts/verify-evidence.mjs"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.7.0",
