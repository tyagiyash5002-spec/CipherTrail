    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.544.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "protobufjs": "^7.6.6",
